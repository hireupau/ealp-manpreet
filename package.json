{
  "name": "ealp-manpreet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "tsx --env-file=.env src/main.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "cursor": "tsx --env-file=.env scripts/set-cursor.ts",
    "try": "tsx --env-file=.env scripts/try.ts",
    "replay": "tsx --env-file=.env scripts/replay.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hireupau/ealp-manpreet.git"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@strands-agents/sdk": "^1.19.0",
    "hono": "^4.13.9",
    "openai": "^6.49.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
