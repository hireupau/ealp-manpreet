PORT=3100
# Any long random string. Must match the secret set on the GitHub webhook.
GITHUB_WEBHOOK_SECRET=change-me

GITHUB_REPO=hireupau/engineering-ai-learning-project
POLL_INTERVAL_MS=30000
DB_PATH=data/ealp.db
# Only act on PRs by these GitHub logins (comma-separated)
GITHUB_AUTHOR_FILTER=your-github-login
# regex | workflow | autonomous
AGENT_MODE=workflow

# Fine-grained PAT: owner hireupau, repo engineering-ai-learning-project, read-only PRs + Metadata
GITHUB_PERSONAL_ACCESS_TOKEN=

# Scoped Jira token (read:jira-work, write:jira-work). Calls go via api.atlassian.com
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_CLOUD_ID=2cd5001d-df21-41f3-8cf5-2130a7c08a22

# LMStudio OpenAI-compatible server
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=
LLM_API_KEY=

# Langfuse Cloud
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# smee.io channel URL
SMEE_URL=